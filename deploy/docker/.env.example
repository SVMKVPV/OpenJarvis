# Copy to `.env` in this directory (deploy/docker/.env) before `docker compose up`.
# docker-compose.yml requires this — the container binds 0.0.0.0, so the
# server refuses to start without an API key.
#
# Generate a key with:  openssl rand -hex 32
# Then clients must send:  Authorization: Bearer <key>
OPENJARVIS_API_KEY=

# Bind both published ports to loopback when an HTTPS reverse proxy runs on this host.
# OPENJARVIS_BIND_ADDRESS=127.0.0.1
# Comma-separated browser origins permitted to call the API.
# OPENJARVIS_CORS_ORIGINS=https://your-command-center.netlify.app
# Optional JSON map of saved workflow ID to SHA-256 digest of its launch key.
# OPENJARVIS_WORKFLOW_LAUNCH_KEYS='{}'

# Optional SHA-256 digest of a separate key that can only read the Shared Brain brief.
# OPENJARVIS_SHARED_BRAIN_READ_KEY_SHA256=
